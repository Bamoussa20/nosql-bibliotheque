# Copiez ce fichier vers ".env" et renseignez vos propres identifiants.
# Ne jamais versionner le fichier ".env" réel dans Git.

# URI de connexion à votre cluster MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Nom de la base de données utilisée par le projet (optionnel)
DATABASE_NAME=bibliotheque_nosql
